# LLM Provider: "gemini" | "groq" | "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/decisionos
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/decisionos

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=decisionos

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
SECRET_KEY=super-secret-key-change-in-production
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# CORS
CORS_ORIGINS=http://localhost:3000
